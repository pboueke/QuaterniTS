# Toolkit mechanics for QuaterniTS. Included by the root Makefile.
#
# Requires only: podman (rootless), make, bash, git. The toolkit image is a
# disposable, stateless test tool: the repository is bind-mounted at /work and
# dependencies are installed from the frozen package-lock.json with `npm ci`.
# Nothing is baked into the image and no host Node is required.

TOOLKIT_DIR := toolkit
TOOLKIT_CONTAINERFILE := $(TOOLKIT_DIR)/Containerfile
TOOLKIT_IMAGE ?= quaternits-toolkit:local
TOOLKIT_NPM_CACHE ?= quaternits-npm-cache
# Brand-specific stamps prevent the old image/dependency stamps from silently
# skipping the first build after the toolkit image and cache rename.
TOOLKIT_IMAGE_STAMP := .toolkit/quaternits-image.stamp
TOOLKIT_NPM_CI_STAMP := .toolkit/quaternits-npm-ci.stamp

# Verified digest: the multi-arch manifest-list digest for
# docker.io/library/node:24-bookworm-slim, resolved during implementation and
# recorded in toolkit/README.md. Never invent or hand-edit this value.
TOOLKIT_BASE_DIGEST ?= sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
TOOLKIT_BASE_IMAGE ?= docker.io/library/node:24-bookworm-slim@$(TOOLKIT_BASE_DIGEST)

# Run a command in the disposable toolkit with the repo mounted at /work.
# keep-id maps the host user to container uid/gid 1000 (`node`) so bind mounts
# stay writable without running as root. Commands must not contain single quotes.
define toolkit-run
podman run --rm --userns=keep-id:uid=1000,gid=1000 \
	-v "$(CURDIR)":/work:Z \
	-v "$(TOOLKIT_NPM_CACHE)":/home/node/.npm:Z \
	-w /work \
	$(TOOLKIT_IMAGE) bash -lc '$(1)'
endef

# Serve a foreground command from the toolkit with only the docs-preview port
# published, and only on host loopback (`127.0.0.1`), never every interface.
# `--init` runs a tiny init as the container's PID 1: a PID 1 with no handler
# ignores SIGINT, so without it Ctrl-C would leave the server running. Astro
# telemetry is disabled. Interactive by design, so this is never part of
# `make verify`.
define toolkit-preview
podman run --rm --init --userns=keep-id:uid=1000,gid=1000 \
	-p 127.0.0.1:4321:4321 \
	-v "$(CURDIR)":/work:Z \
	-w /work \
	-e ASTRO_TELEMETRY_DISABLED=1 \
	$(TOOLKIT_IMAGE) bash -lc '$(1)'
endef

# The real-browser gate's image: a project-owned tag (`quaternits-`, 001/D43)
# derived from the digest-pinned official Playwright image that
# toolkit/Containerfile.browser names. The vendor image ships Chromium and its
# system libraries but no npm `playwright` package, so the gate installs the
# exact matching `playwright-core` in the pinned toolkit instead.
BROWSER_IMAGE ?= quaternits-browser:local
BROWSER_CONTAINERFILE := $(TOOLKIT_DIR)/Containerfile.browser
BROWSER_IMAGE_STAMP := .toolkit/quaternits-browser-image.stamp

# Run a command in the pinned browser image with the repo mounted at /work.
# `--network=none` is deliberate: the gate serves the installed tarball over
# loopback inside the container, so a browser test can never reach the network
# or silently depend on a CDN or a remote module shim. keep-id maps the host
# user to the container's uid/gid 1000 user, so the mounted build stays
# writable without running as root. Commands must not contain single quotes.
define browser-run
podman run --rm --network=none --userns=keep-id:uid=1000,gid=1000 \
	-v "$(CURDIR)":/work:Z \
	-w /work \
	$(BROWSER_IMAGE) bash -lc '$(1)'
endef

# Host-side preflight: fail loudly when rootless Podman is unusable, so no gate
# can skip a check or report a fake result. It verifies a usable rootless
# Podman, not that the pinned image runs; the gate targets that follow actually
# execute the image. `make verify`, the git hooks and CI all start here.
.PHONY: preflight
preflight: ## Fail loudly unless rootless Podman is usable
	bash $(TOOLKIT_DIR)/scripts/preflight.sh

.PHONY: toolkit-image
toolkit-image: $(TOOLKIT_IMAGE_STAMP) ## Build the digest-pinned toolkit image

$(TOOLKIT_IMAGE_STAMP): $(TOOLKIT_CONTAINERFILE)
	@mkdir -p $(dir $@)
	podman build -t $(TOOLKIT_IMAGE) -f $(TOOLKIT_CONTAINERFILE) $(TOOLKIT_DIR)
	@touch $@

.PHONY: browser-image
browser-image: $(BROWSER_IMAGE_STAMP) ## Build the pinned browser image (large: pulls the Playwright base once)

$(BROWSER_IMAGE_STAMP): $(BROWSER_CONTAINERFILE)
	@mkdir -p $(dir $@)
	podman build --pull=missing -t $(BROWSER_IMAGE) \
		-f $(BROWSER_CONTAINERFILE) $(TOOLKIT_DIR)
	@touch $@

$(TOOLKIT_NPM_CI_STAMP): package.json package-lock.json $(TOOLKIT_IMAGE_STAMP)
	@mkdir -p $(dir $@)
	$(call toolkit-run,npm ci --no-audit --no-fund)
	@touch $@

.PHONY: toolkit-deps
toolkit-deps: $(TOOLKIT_NPM_CI_STAMP) ## Install dependencies from the frozen lockfile
